# Sunucu portu (Render bunu otomatik tanimlar, lokalde varsayilan 5000)
PORT=5000

# Lokal gelistirmede hata ayiklama modu (Render'da tanimlamayin)
FLASK_DEBUG=1

# Istege bagli: PostgreSQL baglantisi. Tanimli degilse /api devre disi kalir, site yine calisir.
# Render Postgres kullanirsaniz "Internal Database URL" degerini buraya verin.
# DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani

# Istege bagli: canonical/sitemap adresini elle belirlemek icin.
# Render'da RENDER_EXTERNAL_URL (https://<servis>.onrender.com) otomatik kullanilir.
# SITE_URL=https://ornek.onrender.com

# Istege bagli: /api icin izin verilen originler (varsayilan *)
# CORS_ORIGINS=https://ornek.onrender.com
